{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/e/:id",
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/((?!assets/|api/|data/|share/|e/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/translate.ts": {
      "maxDuration": 60
    },
    "api/push.ts": {
      "maxDuration": 60
    }
  }
}
