# Osintfront satellite enhance worker — copy to .env and fill in. Never share or upload .env.

# Supabase → Project Settings → API. The service_role key is a full-access key: keep it on this computer only.
SUPABASE_URL=https://kbfggmvrfevstzneqfzf.supabase.co
SUPABASE_SERVICE_KEY=

# Engine loaded at start (each job still runs with the engine stored on it). Empty = sen2sr_lite_rgbn_x4.
ENGINE=
# Box side in 10 m pixels (256 = 2.56 km → 1024 px at 2.5 m). Smaller = faster on a slow CPU; at least 128.
BOX_PX=256
# Without a date: the newest picture whose box has at most this % cloud; otherwise the least cloudy.
MAX_CLOUD=10
POLL_SECONDS=15
# CPU threads for the model (empty = PyTorch default).
TORCH_THREADS=
# 1 = remove the +1000 reflectance offset of Sentinel-2 processing baseline 04.00+ (recommended).
HARMONIZE=1
