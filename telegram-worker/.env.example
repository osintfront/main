# From https://my.telegram.org → "API development tools" (you create these yourself).
API_ID=
API_HASH=

# Osintfront ingest endpoint and the worker's own token.
INGEST_URL=https://kbfggmvrfevstzneqfzf.supabase.co/functions/v1/whatsapp-ingest
INGEST_TOKEN=

# Which Telegram tabs (folders) to collect from, separated by |  — empty = all tabs.
FOLDERS=

# On start, also pick up posts missed while the computer was off (max hours back).
CATCH_UP_HOURS=2

# Claude API use (cost) per channel type:
#   full  = classify + editor (translation to Hebrew, places on the map)  ~10x the cost of light
#   light = classify only, for Hebrew posts (non-Hebrew posts still get the editor)
#   off   = skip this type
# Public = has a t.me/<name> link. Private = invite-only.
PUBLIC_MODE=light
PRIVATE_MODE=full
# Posts shorter than this (without links) are skipped without calling the API.
MIN_TEXT=25
