# ─────────────────────────────────────────────────────────────
# Osintfront — environment variables (copy to .env.local)
# Only VITE_* variables reach the browser. NEVER put a Supabase
# service-role key, AI provider key or paid geocoding key here.
# Those belong in Supabase Edge Function secrets (Phases 3–5).
# ─────────────────────────────────────────────────────────────

# Supabase project (Settings → API). The anon key is public by design;
# Row Level Security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base map tiles: osm | carto | google
#   osm    → OpenStreetMap standard tiles (default, no API key; light usage only, see OSMF tile policy)
#   carto  → CARTO Voyager / Dark Matter (now requires a CARTO API key)
#   google → reserved; see src/config/map.ts for the swap instructions
VITE_MAP_TILE_PROVIDER=osm

# Public site URL, used for password-reset redirect links.
VITE_SITE_URL=http://localhost:5173
