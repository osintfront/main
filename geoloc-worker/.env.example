# Osintfront geolocation worker — copy to .env and fill in. Never share or upload .env.

# Supabase → Project Settings → API. The service_role key is a full-access key: keep it on this computer only.
SUPABASE_URL=https://kbfggmvrfevstzneqfzf.supabase.co
SUPABASE_SERVICE_KEY=

# console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Scene reading (target pixel, media check). Compare models on your own verified events before switching.
SCENE_MODEL=claude-opus-5-5
# Cheap first check "is there terrain to match?" — leave empty to skip triage.
TRIAGE_MODEL=claude-haiku-5-5

# Search for the camera within this many km of the reported place.
SEARCH_RADIUS_KM=12
# CPU processes for the terrain search (empty = all cores but one).
CPU_WORKERS=
POLL_SECONDS=20
